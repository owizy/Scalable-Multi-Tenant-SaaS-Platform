# Root Monorepo Global Environment Configuration Template

# Database Connections
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/multi_tenant"
REDIS_URL="redis://localhost:6379"

# Core API & Gateway Settings
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
ALLOWED_ORIGINS="http://localhost:3000"

# Authentication & Tokens
JWT_SECRET="replace_this_with_a_secure_long_random_jwt_secret_key"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_SECRET="replace_this_with_a_secure_long_random_refresh_token_secret_key"
REFRESH_TOKEN_EXPIRATION="7d"

# Stripe Billing
STRIPE_SECRET_KEY="sk_test_example"
STRIPE_WEBHOOK_SECRET="whsec_example"

# AI Integrations
GEMINI_API_KEY="your_google_ai_key"

# AWS Cloud Storage & KMS
STORAGE_DRIVER=local
AWS_S3_BUCKET="multi-tenant-storage"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
KMS_MASTER_KEY_ARN=""

# OpenTelemetry & APM Tracing
OTEL_SERVICE_NAME="multi-tenant-platform"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"
APM_TRACING_ENABLED=true
